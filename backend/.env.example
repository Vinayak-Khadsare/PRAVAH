# PRAVAH — Backend Environment Configuration Example
# Copy this file to .env and provide your MongoDB Atlas credentials and secrets.

# MongoDB Atlas Connection URI (keep strictly private, never commit credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pravah_aicte_db?retryWrites=true&w=majority

# Database name
DATABASE_NAME=pravah_aicte_db

# Security & Session Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-for-session-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
