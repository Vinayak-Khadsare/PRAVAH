# PRAVAH — AICTE Approval Operations Platform
# Environment Configuration Template
# Copy this file to .env and customize for your local setup or production.

# ==========================================
# 1. SERVER & RUNTIME
# ==========================================
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# ==========================================
# 2. DATABASE CONFIGURATION (MongoDB)
# ==========================================
# Local MongoDB connection (default):
MONGODB_URI=mongodb://127.0.0.1:27017/pravah_aicte_db
DATABASE_NAME=pravah_aicte_db

# MongoDB Atlas format (uncomment and replace credentials if using cloud Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pravah_aicte_db?retryWrites=true&w=majority

# Note: If no MongoDB instance is reachable, PRAVAH safely operates
# in zero-config In-Memory Demonstration Mode for instant exploration.

# ==========================================
# 3. SECURITY & AUTHENTICATION
# ==========================================
# Cryptographic signing secret for JWT session tokens (min 32 chars in production)
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key-for-pravah-session-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================
# 4. STORAGE & DOCUMENT UPLOADS
# ==========================================
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_BYTES=26214400

# ==========================================
# 5. AUTOMATED DEADLINE MONITORING
# ==========================================
ENABLE_DEADLINE_SCHEDULER=true
DEADLINE_CHECK_INTERVAL_SECONDS=60
