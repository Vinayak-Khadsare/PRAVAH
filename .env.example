# PRAVAH — Policy-driven Regulatory Approval & Verification Automation Hub
# Environment Configuration Template
# Copy this file to .env and configure for your local environment or MongoDB Atlas.

# ==========================================
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ==========================================
# MongoDB Atlas Connection URI (keep strictly private, never commit credentials)
# In development without an Atlas URI, PRAVAH operates in explicit, transparent local persistence mode.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pravah_aicte_db?retryWrites=true&w=majority
DATABASE_NAME=pravah_aicte_db

# ==========================================
# 2. SECURITY & AUTHENTICATION
# ==========================================
# 256-bit cryptographic signing secret for JWT access tokens
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key-for-pravah-session-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================
# 3. SERVER & CORS
# ==========================================
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 4. STORAGE & DOCUMENT UPLOADS
# ==========================================
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_BYTES=26214400

# ==========================================
# 5. AUTOMATED DEADLINE MONITORING & ALERTS
# ==========================================
ENABLE_DEADLINE_SCHEDULER=true
DEADLINE_CHECK_INTERVAL_SECONDS=3600
NOTIFICATION_PROVIDER=in_app

# ==========================================
# 6. LOCAL LLM / OLLAMA (Optional, Core works without LLM)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
